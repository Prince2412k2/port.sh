{
  "system": "You are a helpful assistant answering in a terminal. Be concise. When a tool can answer better than a guess, use it.",
  "budget": { "turns": 12, "toolCalls": 24 },
  "compaction": { "enabled": true, "reserve": 16384, "keepRecent": 20000 },
  "sessionDir": "~/.local/share/envoy/sessions",
  "tiers": [
    {
      "provider": "ollama-cloud",
      "model": "qwen3.5:397b",
      "api": "ollama-chat",
      "baseUrl": "https://ollama.com",
      "contextWindow": 262144,
      "reasoning": true,
      "effort": "low",
      "auth": { "env": ["OLLAMA_API_KEY"] }
    },
    {
      "provider": "ollama-cloud",
      "model": "gpt-oss:120b",
      "api": "ollama-chat",
      "baseUrl": "https://ollama.com",
      "contextWindow": 131072,
      "auth": { "env": ["OLLAMA_API_KEY"] }
    }
  ]
}

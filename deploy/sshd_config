# Everything here is either "run the portfolio" or "no".

Port 22
AddressFamily any

# Host keys live on a volume. Regenerating them on every deploy would show
# every returning visitor a man-in-the-middle warning, which is the single
# fastest way to make a portfolio look like a compromise.
HostKey /etc/ssh/keys/ssh_host_ed25519_key

# Any key gets in. There is nothing behind this to protect, and asking
# strangers to register a key to read a CV is a worse trade than accepting
# whatever they already have. `anykey` echoes back the key that was offered,
# which is what makes every key authorised.
PubkeyAuthentication yes
AuthorizedKeysFile none
AuthorizedKeysCommand /usr/local/bin/anykey %t %k
AuthorizedKeysCommandUser nobody

# This still requires the *account* named in the login (visitor@host) to
# exist -- sshd looks that up before it will even run AuthorizedKeysCommand,
# so "any key gets in" does not mean "any username" gets in. There is only
# one account, visitor, so that is what every connection has to name.

PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
UsePAM no

# The whole point. Whatever is asked for, this is what runs.
ForceCommand /usr/local/bin/portfolio
PermitTTY yes

# Nothing else. An SSH server on a public port with forwarding enabled is an
# open proxy, and this one has no reason to forward anything.
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no
PermitUserRC no
PermitUserEnvironment no
Subsystem sftp /bin/false

# Manners toward the machine.
LoginGraceTime 20
MaxAuthTries 3
MaxSessions 2
MaxStartups 20:50:60
ClientAliveInterval 120
ClientAliveCountMax 3

LogLevel INFO
PrintMotd no
PrintLastLog no

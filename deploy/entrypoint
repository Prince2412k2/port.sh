#!/bin/sh
set -eu

# sshd's privilege-separation directory. The Dockerfile creates this at build
# time, but the compose file mounts a fresh tmpfs over /run so the container
# can run with a read-only root filesystem -- which replaces whatever was
# there at build time with an empty directory. It has to be remade here, every
# start, on the tmpfs itself.
mkdir -p /run/sshd
chmod 0755 /run/sshd

# Generate the host key once, into the volume. Same key across restarts and
# redeploys, so returning visitors do not get a changed-fingerprint warning.
if [ ! -f /etc/ssh/keys/ssh_host_ed25519_key ]; then
    echo "entrypoint: generating a host key (first run)" >&2
    ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/keys/ssh_host_ed25519_key
fi
chmod 600 /etc/ssh/keys/ssh_host_ed25519_key

# Say plainly whether the map has anything to draw. Without the archive the
# renderer falls back to a small extract of Mumbai, and a tour of Gujarat drawn
# over Mumbai is not a degraded map, it is a wrong one.
if [ ! -f "${TERMAP_DATA:-/app/data}/india.pmtiles" ]; then
    echo "entrypoint: no basemap at ${TERMAP_DATA:-/app/data}/india.pmtiles" >&2
    echo "entrypoint: the experience section will say so. See deploy/README.md" >&2
fi

exec /usr/sbin/sshd -D -e

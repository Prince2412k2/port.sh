#!/usr/bin/env python3
"""Who has been here. An interactive reader for the visit log.

    bin/visitors                     on the box, against the real log
    bin/visitors --file some.jsonl   against a copy
    bin/visitors --docker            read it out of the running container

Keys
    up down j k     move            enter space     open a visitor
    /               search          esc             clear the search
    s               sort            r               returning only
    g G             top / bottom    q               quit

People are folded by default: one row each, how many times they came and when
they were last here. Open one to see every visit and everything they asked.

Nothing here writes. Safe against a live log -- a half-written last line is
skipped rather than crashing the reader.
"""

import argparse
import curses
import json
import os
import subprocess
import sys
import time
from collections import defaultdict

CANDIDATES = [
    os.environ.get("PORTFOLIO_VISITS"),
    "/app/messages/visits.jsonl",
    "data/visits.jsonl",
    "portfolio/data/visits.jsonl",
]

SORTS = [
    ("last seen", lambda p: -p["last"]),
    ("visits", lambda p: (-p["visits"], -p["last"])),
    ("questions", lambda p: (-p["asked"], -p["last"])),
    ("time spent", lambda p: (-p["secs"], -p["last"])),
    ("name", lambda p: (p["name"].lower(), -p["last"])),
]


def read_log(path):
    """Every event, grouped into sessions. Bad lines are skipped."""
    sessions = {}
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError as e:
        sys.exit(f"cannot read {path}: {e}")
    with fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            sid = e.get("session")
            if not sid:
                continue
            s = sessions.setdefault(
                sid,
                {"at": 0, "name": "", "ident": "", "via": "", "ip": "", "client": "",
                 "where": "", "secs": 0, "turns": 0, "chat": []},
            )
            ev = e.get("event")
            if ev == "arrive":
                s["at"] = e.get("at", 0)
                s["name"] = e.get("user") or ""
                s["ident"] = e.get("id") or ""
                s["via"] = e.get("via") or ""
                s["ip"] = e.get("ip") or ""
                s["client"] = e.get("client") or ""
            elif ev == "where":
                s["where"] = ", ".join(
                    x for x in (e.get("city"), e.get("region"), e.get("country")) if x
                )
            elif ev == "ask":
                s["chat"].append((e.get("q", ""), e.get("a", "")))
            elif ev == "leave":
                s["secs"] = e.get("secs", 0)
                s["turns"] = e.get("turns", 0)
    return [s for s in sessions.values() if s["at"]]


def fold(sessions):
    """One entry per person, newest visit first.

    Keyed on the identity where there is one -- an SSH key fingerprint or the
    browser's own id -- and on the address otherwise, so anonymous visits from
    one place group without pretending to be a known person.
    """
    people = defaultdict(lambda: {"visits": 0, "asked": 0, "secs": 0, "first": 0,
                                  "last": 0, "name": "", "ident": "", "via": "",
                                  "wheres": set(), "client": "", "sessions": []})
    for s in sessions:
        key = s["ident"] or f'anon:{s["ip"]}:{s["via"]}'
        p = people[key]
        p["visits"] += 1
        p["asked"] += s["turns"] or len(s["chat"])
        p["secs"] += s["secs"]
        p["last"] = max(p["last"], s["at"])
        p["first"] = min(p["first"] or s["at"], s["at"])
        p["ident"] = p["ident"] or s["ident"]
        p["via"] = p["via"] or s["via"]
        p["client"] = p["client"] or s["client"]
        if s["where"]:
            p["wheres"].add(s["where"])
        if s["name"]:
            p["name"] = s["name"]
        p["sessions"].append(s)
    for p in people.values():
        p["sessions"].sort(key=lambda s: -s["at"])
        if not p["name"]:
            p["name"] = "browser" if p["via"] == "web" else "anonymous"
    return list(people.values())


def when(ts):
    return time.strftime("%d %b %H:%M", time.localtime(ts)) if ts else "?"


def ago(ts):
    if not ts:
        return "?"
    d = max(0, int(time.time() - ts))
    if d < 3600:
        return f"{d // 60}m ago"
    if d < 86400:
        return f"{d // 3600}h ago"
    return f"{d // 86400}d ago"


def howlong(secs):
    if secs <= 0:
        return "-"
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    return f"{secs // 3600}h{(secs % 3600) // 60:02d}"


def cut(s, n):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: max(0, n - 1)] + "…"


class Reader:
    def __init__(self, path, people):
        self.path = path
        self.all = people
        self.sort = 0
        self.query = ""
        self.searching = False
        self.returning_only = False
        self.cursor = 0
        self.top = 0
        self.open_at = None   # index into the filtered list, or None
        self.detail_scroll = 0

    def rows(self):
        out = self.all
        if self.returning_only:
            out = [p for p in out if p["visits"] > 1]
        if self.query:
            q = self.query.lower()
            def hit(p):
                hay = " ".join([
                    p["name"], p["ident"], p["via"], p["client"],
                    " ".join(sorted(p["wheres"])),
                    " ".join(q for s in p["sessions"] for q, _ in s["chat"]),
                ]).lower()
                return q in hay
            out = [p for p in out if hit(p)]
        return sorted(out, key=SORTS[self.sort][1])

    # -- drawing ---------------------------------------------------------

    def draw(self, scr):
        scr.erase()
        h, w = scr.getmaxyx()
        rows = self.rows()
        self.cursor = max(0, min(self.cursor, max(0, len(rows) - 1)))

        title = f" {len(rows)} visitor{'' if len(rows) == 1 else 's'}"
        bits = [f"sort: {SORTS[self.sort][0]}"]
        if self.returning_only:
            bits.append("returning only")
        if self.query:
            bits.append(f"/{self.query}")
        head = title + "   " + "   ".join(bits)
        scr.addnstr(0, 0, head.ljust(w - 1), w - 1, curses.A_BOLD)
        scr.addnstr(1, 0, "─" * (w - 1), w - 1, curses.color_pair(3))

        if self.open_at is not None and rows:
            self.draw_detail(scr, rows[min(self.open_at, len(rows) - 1)], 2, h - 1, w)
        else:
            self.draw_list(scr, rows, 2, h - 1, w)

        keys = ("enter open   / search   s sort   r returning   q quit"
                if self.open_at is None else
                "esc back   up/down scroll   q quit")
        scr.addnstr(h - 1, 0, keys.ljust(w - 1), w - 1, curses.color_pair(3))
        if self.searching:
            scr.addnstr(h - 1, 0, f"search: {self.query}".ljust(w - 1), w - 1,
                        curses.A_BOLD)
        scr.refresh()

    def draw_list(self, scr, rows, y0, y1, w):
        room = y1 - y0 - 1
        if self.cursor < self.top:
            self.top = self.cursor
        if self.cursor >= self.top + room:
            self.top = self.cursor - room + 1

        hdr = f"{'who':<18}{'via':<5}{'from':<26}{'visits':<8}{'asked':<7}{'time':<7}last"
        scr.addnstr(y0, 0, hdr[: w - 1], w - 1, curses.color_pair(3))
        if not rows:
            scr.addnstr(y0 + 2, 2, "nothing matches.", w - 3, curses.color_pair(3))
            return
        for i, p in enumerate(rows[self.top : self.top + room]):
            y = y0 + 1 + i
            here = (self.top + i) == self.cursor
            where = ", ".join(sorted(p["wheres"])) or "(not looked up)"
            times = f'{p["visits"]}×' if p["visits"] > 1 else "1"
            line = (
                f'{cut(p["name"], 17):<18}'
                f'{p["via"]:<5}'
                f'{cut(where, 25):<26}'
                f'{times:<8}'
                f'{p["asked"]:<7}'
                f'{howlong(p["secs"]):<7}'
                f'{ago(p["last"])}'
            )
            attr = curses.A_REVERSE if here else 0
            if p["visits"] > 1 and not here:
                attr = curses.color_pair(2)
            scr.addnstr(y, 0, line.ljust(w - 1), w - 1, attr)

    def draw_detail(self, scr, p, y0, y1, w):
        lines = []
        lines.append((p["name"], curses.A_BOLD))
        lines.append((f'  {p["ident"] or "(no identity offered)"}', 3))
        lines.append((f'  {p["visits"]} visit(s), {p["asked"]} question(s), '
                      f'{howlong(p["secs"])} in total', 0))
        lines.append((f'  first {when(p["first"])}   last {when(p["last"])}', 0))
        lines.append((f'  from  {", ".join(sorted(p["wheres"])) or "?"}', 0))
        if p["client"]:
            lines.append((f'  via   {cut(p["client"], w - 10)}', 3))
        lines.append(("", 0))
        for s in p["sessions"]:
            lines.append((f'{when(s["at"])}   {howlong(s["secs"])}   '
                          f'{s["turns"] or len(s["chat"])} question(s)', 2))
            for q, a in s["chat"]:
                lines.append((f"  > {q}", curses.A_BOLD))
                for para in str(a).split("\n"):
                    para = para.rstrip()
                    if not para:
                        continue
                    while len(para) > w - 6:
                        take = para[: w - 6].rfind(" ")
                        take = take if take > 20 else w - 6
                        lines.append((f"    {para[:take]}", 0))
                        para = para[take:].lstrip()
                    lines.append((f"    {para}", 0))
                lines.append(("", 0))
            if not s["chat"]:
                lines.append(("  (said nothing)", 3))
                lines.append(("", 0))

        room = y1 - y0
        self.detail_scroll = max(0, min(self.detail_scroll, max(0, len(lines) - room)))
        for i, (text, attr) in enumerate(lines[self.detail_scroll : self.detail_scroll + room]):
            a = attr if isinstance(attr, int) and attr > 8 else 0
            if attr in (2, 3):
                a = curses.color_pair(attr)
            scr.addnstr(y0 + i, 0, text[: w - 1], w - 1, a)

    # -- input -----------------------------------------------------------

    def key(self, ch):
        if self.searching:
            if ch in (27,):
                self.searching = False
            elif ch in (10, 13, curses.KEY_ENTER):
                self.searching = False
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                self.query = self.query[:-1]
            elif 32 <= ch < 127:
                self.query += chr(ch)
            self.cursor = 0
            return True

        if self.open_at is not None:
            if ch in (27, ord("q"), curses.KEY_LEFT, ord("h")):
                if ch == ord("q"):
                    return False
                self.open_at = None
                self.detail_scroll = 0
            elif ch in (curses.KEY_DOWN, ord("j")):
                self.detail_scroll += 1
            elif ch in (curses.KEY_UP, ord("k")):
                self.detail_scroll = max(0, self.detail_scroll - 1)
            elif ch == curses.KEY_NPAGE:
                self.detail_scroll += 15
            elif ch == curses.KEY_PPAGE:
                self.detail_scroll = max(0, self.detail_scroll - 15)
            return True

        if ch in (ord("q"),):
            return False
        if ch in (curses.KEY_DOWN, ord("j")):
            self.cursor += 1
        elif ch in (curses.KEY_UP, ord("k")):
            self.cursor = max(0, self.cursor - 1)
        elif ch == curses.KEY_NPAGE:
            self.cursor += 15
        elif ch == curses.KEY_PPAGE:
            self.cursor = max(0, self.cursor - 15)
        elif ch == ord("g"):
            self.cursor = 0
        elif ch == ord("G"):
            self.cursor = 10 ** 9
        elif ch == ord("s"):
            self.sort = (self.sort + 1) % len(SORTS)
        elif ch == ord("r"):
            self.returning_only = not self.returning_only
            self.cursor = 0
        elif ch == ord("/"):
            self.searching = True
            self.query = ""
        elif ch == 27:
            self.query = ""
        elif ch in (10, 13, curses.KEY_ENTER, ord(" "), curses.KEY_RIGHT, ord("l")):
            if self.rows():
                self.open_at = self.cursor
                self.detail_scroll = 0
        return True


def run(scr, reader):
    curses.curs_set(0)
    curses.use_default_colors()
    for i, fg in ((1, curses.COLOR_CYAN), (2, curses.COLOR_YELLOW), (3, 8)):
        try:
            curses.init_pair(i, fg, -1)
        except curses.error:
            curses.init_pair(i, curses.COLOR_WHITE, -1)
    while True:
        reader.draw(scr)
        try:
            ch = scr.getch()
        except KeyboardInterrupt:
            return
        if not reader.key(ch):
            return


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--file")
    ap.add_argument("--docker", action="store_true",
                    help="copy the log out of the running container first")
    ap.add_argument("--service", default="portfolio")
    args = ap.parse_args()

    path = args.file
    if args.docker:
        path = "/tmp/portfolio-visits-snapshot.jsonl"
        with open(path, "w", encoding="utf-8") as out:
            r = subprocess.run(
                ["docker", "compose", "exec", "-T", args.service,
                 "cat", "/app/messages/visits.jsonl"],
                stdout=out, stderr=subprocess.PIPE, text=True,
            )
        if r.returncode != 0:
            sys.exit(f"could not read the container's log:\n{r.stderr.strip()}")
    if not path:
        for p in CANDIDATES:
            if p and os.path.exists(p):
                path = p
                break
    if not path:
        sys.exit(
            "no visit log found. Tried:\n  "
            + "\n  ".join(p for p in CANDIDATES if p)
            + "\n\nOn the host, the real one lives in the container: "
              "bin/visitors --docker"
        )

    sessions = read_log(path)
    if not sessions:
        sys.exit(f"{path} has no visits in it yet.")
    reader = Reader(path, fold(sessions))
    curses.wrapper(run, reader)
    print(f"{len(reader.all)} visitor(s) from {path}")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""The visit log, printed. A fallback for when the binary is not to hand.

    bin/visits                     $PORTFOLIO_VISITS, or the usual places
    bin/visits --file some.jsonl   a copy taken off the box

`portfolio --visitors` is the real reader: it browses people, folds their
visits, and opens any conversation back up in the chat itself, with the maps
and diagrams that came with each answer. Nothing here can do that, because
those are the app's own renderers and they are in the app.

This exists for the one case that cannot cover -- a log copied onto a machine
with no build of it -- so it stays small enough to be obviously right and does
not grow features. Nothing here writes, and a half-written last line is skipped
rather than fatal.
"""

import argparse
import json
import os
import sys
from datetime import datetime, timezone

CANDIDATES = [
    os.environ.get("PORTFOLIO_VISITS"),
    "/app/messages/visits.jsonl",
    "data/visits.jsonl",
]


def when(ts):
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%d %H:%M")


def howlong(secs):
    if secs is None:
        return "open"
    h, m, s = secs // 3600, (secs % 3600) // 60, secs % 60
    return f"{h}h{m:02d}m" if h else (f"{m}m{s:02d}s" if m else f"{s}s")


def read(path):
    """Sessions, in the order they first appear."""
    order, stays = [], {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            sid = e.get("session")
            if not sid:
                continue
            if sid not in stays:
                order.append(sid)
                stays[sid] = {"at": 0, "who": "", "ip": "", "via": "", "where": "",
                              "secs": None, "said": [], "sent": []}
            s = stays[sid]
            ev = e.get("event")
            if ev == "arrive":
                s["at"] = e.get("at", 0)
                s["who"] = e.get("user") or (e.get("id") or "")[:14] or "someone"
                s["ip"] = e.get("ip") or ""
                s["via"] = e.get("via") or ""
            elif ev == "where":
                # A city that is its own region says itself twice otherwise.
                parts = [e.get("city"), e.get("region"), e.get("country")]
                s["where"] = ", ".join(dict.fromkeys(p for p in parts if p))
            elif ev == "ask":
                s["said"].append((e.get("q", ""), ""))
            elif ev == "question_status":
                s["said"].append((e.get("q", ""), e.get("status", "")))
            elif ev == "question":
                s["sent"].append(e.get("q", ""))
            elif ev == "leave":
                s["secs"] = e.get("secs", 0)

    out = []
    for sid in order:
        s = stays[sid]
        # A question is logged when it is sent and again when it comes back, so
        # what is left in `sent` never returned at all.
        seen = {q for q, _ in s["said"]}
        s["said"] += [(q, "unanswered") for q in s["sent"] if q not in seen]
        # And a run of the same one is one thing that happened several times.
        folded = []
        for entry in s["said"]:
            if folded and folded[-1][0] == entry:
                folded[-1][1] += 1
            else:
                folded.append([entry, 1])
        s["said"] = folded
        out.append(s)
    return out


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--file")
    args = ap.parse_args()

    path = args.file or next((p for p in CANDIDATES if p and os.path.exists(p)), None)
    if not path:
        sys.exit("no visit log found. Tried:\n  " + "\n  ".join(p for p in CANDIDATES if p))

    stays = read(path)
    if not stays:
        sys.exit(f"{path} has no visits in it yet.")

    asked = 0
    for s in sorted(stays, key=lambda s: s["at"]):
        n = sum(times for _, times in s["said"])
        asked += n
        bits = [x for x in (s["ip"], s["where"], howlong(s["secs"]),
                            f"{n} question{'' if n == 1 else 's'}") if x]
        print(f"{when(s['at'])}  {s['via'] or '?':<4} {s['who']}  ·  " + "  ·  ".join(bits))
        for (q, status), times in s["said"]:
            marks = ([status] if status else []) + ([f"x{times}"] if times > 1 else [])
            print(f"      {q}" + (f"   [{', '.join(marks)}]" if marks else ""))
        print()

    print(f"{len(stays)} visit(s)  ·  {asked} question(s)  ·  {path}")
    print("`portfolio --visitors` reads these as people, and opens the chats.")


if __name__ == "__main__":
    main()
